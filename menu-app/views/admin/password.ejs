<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sadem Meyhane · Şifre Değiştir</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/css/style.css">

<header class="admin-header">
  <h1>Şifre Değiştir</h1>
  <nav class="admin-nav"><a href="/admin">← Panele dön</a></nav>
</header>

<main class="admin">
  <% if (error) { %><p class="alert alert-error"><%= error %></p><% } %>

  <form class="card form" method="post" action="/admin/password">
    <label>Mevcut Şifre
      <input type="password" name="current" required autocomplete="current-password">
    </label>
    <label>Yeni Şifre <small>(en az 6 karakter)</small>
      <input type="password" name="password" required minlength="6" autocomplete="new-password">
    </label>
    <label>Yeni Şifre (Tekrar)
      <input type="password" name="confirm" required minlength="6" autocomplete="new-password">
    </label>
    <button type="submit" class="btn btn-primary">Şifreyi Güncelle</button>
  </form>
</main>
