<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sadem Meyhane · Eski Usül Meyhane</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/css/style.css">

<header class="menu-header">
  <div class="logo">
    <!-- Zeytin dalı ve rakı kadehi motifi -->
    <svg viewBox="0 0 100 64" width="92" height="59" fill="none" stroke="#2e2921" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M10 56 C 28 48, 44 34, 58 14" />
      <path d="M20 46 Q 12 40 15 31 Q 24 36 20 46 Z" />
      <path d="M30 37 Q 24 29 29 21 Q 36 27 30 37 Z" />
      <path d="M42 26 Q 38 17 44 10 Q 50 17 42 26 Z" />
      <path d="M52 16 Q 50 7 57 2 Q 61 10 52 16 Z" />
      <path d="M26 50 Q 34 46 40 51 Q 32 57 26 50 Z" />
      <path d="M38 40 Q 46 36 51 42 Q 43 47 38 40 Z" />
      <circle cx="47" cy="33" r="3.1" />
      <circle cx="54" cy="37" r="3.1" />
      <circle cx="54" cy="29" r="3.1" />
      <ellipse cx="76" cy="11" rx="9" ry="2.8" />
      <path d="M67 11 L 69.5 40 Q 76 43.5 82.5 40 L 85 11" />
      <path d="M70 22 Q 76 24 82 22" />
    </svg>
    <span class="logo-name">SADEM</span>
    <span class="logo-sub">Eski usül meyhane</span>
  </div>
  <p class="tagline">Özlüce'nin en keyif alacağınız meyhanesi</p>
  <nav class="cat-nav">
    <% categories.forEach(cat => { %>
      <a href="#kat-<%= cat.id %>"><%= cat.name %></a>
    <% }) %>
  </nav>
</header>

<main class="menu">
  <% categories.forEach(cat => { %>
    <section class="category" id="kat-<%= cat.id %>">
      <h2><%= cat.name %></h2>
      <% cat.products.forEach(p => { %>
        <article class="item <%= p.available ? '' : 'sold-out' %>">
          <% if (p.image) { %>
            <img class="item-photo" src="/uploads/<%= p.image %>" alt="<%= p.name %>" loading="lazy">
          <% } %>
          <div class="item-info">
            <div class="item-top">
              <h3><%= p.name %></h3>
              <span class="dots"></span>
              <span class="price"><%= p.price.toLocaleString('tr-TR', { minimumFractionDigits: 0, maximumFractionDigits: 2 }) %> ₺</span>
            </div>
            <% if (p.description) { %><p class="desc"><%= p.description %></p><% } %>
            <% if (!p.available) { %><span class="badge">Tükendi</span><% } %>
          </div>
        </article>
      <% }) %>
    </section>
  <% }) %>
</main>

<footer class="menu-footer">
  <p class="motto">“Sademde her şey sademce güzel.”</p>
  <p class="address">Özlüce Mah. 415. Sokak No: 93/G · Nilüfer / Bursa</p>
</footer>
