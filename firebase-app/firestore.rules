rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Menü herkese açık okunur; yazma sadece giriş yapmış yöneticiye
    match /categories/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /products/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
